# ── Sistema Operacional ───────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor / IDE ──────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user

# ── Python (scripts de importação) ───────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.env
.venv/
venv/
*.egg-info/

# ── Dados sensíveis / credenciais ─────────────────────────────
# Nunca versionar chaves e senhas!
*.env
.env.local
.env.production
secrets.*
config.local.*

# Credenciais Supabase (se extraídas para arquivo separado)
supabase-credentials.json

# ── Fixtures de teste com dados reais ─────────────────────────
# Os planos de trabalho convertidos para HTML trazem nome, telefone,
# e-mail do coordenador e CPFs da equipe. NUNCA versionar: o repo é
# público. Os testes que dependem deles são pulados quando ausentes
# (tests/pt-parser.test.js).
tests/fixtures/pt-html/

# ── Anexos reais para análise (planos, balancetes, planilhas) ─
# Pasta de trabalho local para documentos originais recebidos da
# FUNAPE/FAPEG/PROAD. Trazem CPF, e-mail e telefone de coordenador
# e bolsistas. NUNCA versionar: o repo é público.
NãoColocarNoGit/

# ── Planilhas Excel (dados brutos — grandes e binários) ───────
# A planilha legada não precisa de versionamento de código.
# Se quiser versionar, remova a linha abaixo.
*.xlsx
*.xls

# ── Node (caso frontend evolua para bundler) ──────────────────
node_modules/
dist/
.cache/
.parcel-cache/

# ── Logs e artefatos temporários ──────────────────────────────
*.log
*.tmp
*.bak
*.swp

# ── Réplica local do banco (tools/replica-local) ──────────────
# Os dumps trazem valores financeiros reais de projetos
# identificaveis, mesmo sem a tabela de bolsistas. O repo e publico:
# versiona-se o script que REMOVE dado, nunca o que o carrega.
tools/replica-local/dump/

# ── Supabase CLI local (config.toml e' versionado; estado local nao) ──
supabase/.branches/
supabase/.temp/

# ── Vigia (tools/vigia) ──────────────────────────────────────
# Palco do clasp: tem .clasp.json com o scriptId do projeto na conta do Victor.
tools/vigia/.publicar/
